# @plugin(@varlock/infisical-plugin)
# @initInfisical(projectId=$INFISICAL_PROJECT_ID, environment=$INFISICAL_ENVIRONMENT, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET, siteUrl=$INFISICAL_SITE_URL, secretPath=/runtime)
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Optional self-hosted Infisical source (docs/infisical.md). Inactive unless a
# private .env.local sets these and opts values in with `KEY=infisical()`.
# Resolver failures stop the command; there is no fallback to local values.
# @internal @sensitive=false
INFISICAL_SITE_URL=
# @internal @sensitive=false
INFISICAL_PROJECT_ID=
# @internal @sensitive=false
INFISICAL_ENVIRONMENT=prod
# Read-only runtime machine identity (Universal Auth).
# @type=infisicalClientId @internal
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @internal
INFISICAL_CLIENT_SECRET=

# Blizzard developer application client ID (client credentials flow).
BLIZZARD_CLIENT_ID=

# Blizzard application secret. Never put credentials in roster JSON.
BLIZZARD_CLIENT_SECRET=

# Private character-to-Discord mapping. JSON format in README.
# @sensitive=false
DISCORD_MAP_FILE=

# Optional Google service account JSON file, shared as editor on your target sheet.
# @sensitive=false
GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional service account key as one-line JSON, for secret stores that inject values
# rather than files. Takes precedence over GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional short-lived OAuth token, alternative to a service account.
GOOGLE_ACCESS_TOKEN=

# Only needed by the explicit sheets command.
GOOGLE_SPREADSHEET_ID=
